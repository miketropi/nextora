{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"customTemplates": [
		{
			"name": "about-us",
			"title": "About Us",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-full-width",
			"title": "Page — Full Width",
			"description": "A page with a full width layout",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "contact-us",
			"title": "Contact Us",
			"description": "A page with a contact us layout with a contact form and a google map",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "theme-terms-conditions",
			"title": "Terms & Conditions",
			"description": "A page with a terms and conditions layout",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "theme-privacy-policy",
			"title": "Privacy Policy",
			"description": "A page with a privacy policy layout",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "frequently-asked-questions",
			"title": "Frequently Asked Questions",
			"description": "A page with a frequently asked questions layout",
			"postTypes": [
				"page",
				"post"
			]
		}
	],
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "footer-4-columns",
			"title": "Footer 4 Columns",
			"area": "footer"
		},
		{
			"name": "footer-newsletter",
			"title": "Footer Newsletter",
			"area": "footer"
		}
	],
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#0a0a0a",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#000000",
					"name": "Primary"
				},
				{
					"slug": "paragraph",
					"color": "#525252",
					"name": "Paragraph"
				},
				{
					"slug": "secondary",
					"color": "#B0B0B0",
					"name": "Secondary"
				},
				{
					"slug": "surface",
					"color": "#f4f4f4",
					"name": "Surface"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				}
			],
			"gradients": [
				{
					"slug": "gradient-primary",
					"gradient": "linear-gradient(135deg, #000000 0%, #0a0a0a 40%, #525252 100%)",
					"name": "Primary"
				},
				{
					"slug": "gradient-secondary",
					"gradient": "linear-gradient(135deg, #0a0a0a 0%, #525252 100%)",
					"name": "Secondary"
				},
				{
					"slug": "gradient-tertiary",
					"gradient": "linear-gradient(90deg, #000000 0%, #525252 100%)",
					"name": "Tertiary"
				},
				{
					"slug": "gradient-subtle",
					"gradient": "linear-gradient(180deg, #f4f4f4 0%, #ffffff 100%)",
					"name": "Subtle"
				},
				{
					"slug": "gradient-soft",
					"gradient": "linear-gradient(135deg, #f9f9f9 0%, #f4f4f4 45%, #ffffff 100%)",
					"name": "Soft"
				},
				{
					"slug": "gradient-overlay",
					"gradient": "linear-gradient(160deg, rgba(10, 10, 10, 0.92) 0%, rgba(82, 82, 82, 0.55) 100%)",
					"name": "Overlay"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"fontFamily": "Arial, Helvetica, sans-serif",
					"name": "Arial",
					"slug": "sans"
				},
				{
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
					"name": "Monospace",
					"slug": "mono"
				},
				{
					"slug": "hanken-grotesk",
					"name": "Hanken Grotesk",
					"fontFamily": "\"Hanken Grotesk\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "300",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-300.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "300",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-300italic.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-regular.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "400",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-italic.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-600.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "600",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-600italic.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-700.woff2"
							]
						},
						{
							"fontFamily": "Hanken Grotesk",
							"fontWeight": "700",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/hanken-grotesk/hanken-grotesk-v12-latin_vietnamese-700italic.woff2"
							]
						}
					]
				},
				{
					"slug": "josefin-sans",
					"name": "Josefin Sans",
					"fontFamily": "\"Josefin Sans\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "300",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-300.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "300",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-300italic.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "400",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-regular.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "400",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-italic.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "600",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-600.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "600",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-600italic.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "700",
							"fontStyle": "normal",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-700.woff2"
							]
						},
						{
							"fontFamily": "Josefin Sans",
							"fontWeight": "700",
							"fontStyle": "italic",
							"src": [
								"file:./assets/fonts/josefin-sans/josefin-sans-v34-latin_vietnamese-700italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "clamp(0.88rem, 0.84rem + 0.35vw, 0.95rem)",
					"name": "Small"
				},
				{
					"slug": "base",
					"size": "clamp(0.9375rem, 0.88rem + 0.45vw, 1.0625rem)",
					"name": "Base"
				},
				{
					"slug": "medium",
					"size": "clamp(1.25rem, 0.94rem + 0.55vw, 1.5rem)",
					"name": "Medium"
				},
				{
					"slug": "medium-plus",
					"size": "clamp(1.375rem, 1.375rem + 0.85vw, 2rem)",
					"name": "Medium Plus"
				},
				{
					"slug": "large",
					"size": "clamp(1.75rem, 1.75rem + 1.2vw, 2.8rem)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(2.1rem, 1.7rem + 2.2vw, 3.2rem)",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(2.2rem, 1.7rem + 3vw, 5rem)",
					"name": "Extra Extra Large"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"size": "clamp(0.75rem, 4vw, 1rem)",
					"slug": "10",
					"name": "Tiny"
				},
				{
					"size": "clamp(1rem, 4vw, 1.5rem)",
					"slug": "20",
					"name": "Small"
				},
				{
					"size": "clamp(1.5rem, 5vw, 2rem)",
					"slug": "30",
					"name": "Medium"
				},
				{
					"size": "clamp(1.8rem, 1.8rem + ((1vw - 0.48rem) * 2.885), 3rem)",
					"slug": "40",
					"name": "Large"
				},
				{
					"size": "clamp(2.5rem, 8vw, 4.5rem)",
					"slug": "50",
					"name": "X-Large"
				},
				{
					"size": "clamp(3.75rem, 10vw, 7rem)",
					"slug": "60",
					"name": "XX-Large"
				}
			],
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--paragraph)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.5"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.15"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--10)"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium-plus)",
					"lineHeight": "1.25"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--20)",
						"bottom": "var(--wp--preset--spacing--10)"
					}
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.3"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--10)",
						"bottom": "0.75rem"
					}
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--base)",
					"lineHeight": "1.35"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--10)",
						"bottom": "0.5rem"
					}
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em",
					"lineHeight": "1.4"
				},
				"spacing": {
					"margin": {
						"top": "var(--wp--preset--spacing--10)",
						"bottom": "0.5rem"
					}
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--paragraph)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"cite": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "italic"
				},
				"color": {
					"text": "var(--wp--preset--color--paragraph)"
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				},
				"color": {
					"text": "var(--wp--preset--color--paragraph)"
				},
				"spacing": {
					"margin": {
						"top": "0.5rem",
						"bottom": "0"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--base)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--primary) 85%, white)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				"border": {
					"radius": "100px",
					"width": "0",
					"style": "none"
				},
				"spacing": {
					"padding": {
						"top": "0.65em",
						"right": "1.25em",
						"bottom": "0.65em",
						"left": "1.25em"
					}
				}
			}
		},
		"blocks": {
			"core/group": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"right": "0",
						"left": "0"
					}
				}
			},
			"core/paragraph": {
				"typography": {
					"lineHeight": "1.65"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/heading": {
				"typography": {
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "1.25rem"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"typography": {
					"lineHeight": "1.65"
				}
			},
			"core/quote": {
				"border": {
					"top": {
						"width": "0"
					},
					"right": {
						"width": "0"
					},
					"bottom": {
						"width": "0"
					},
					"left": {
						"color": "var(--wp--preset--color--primary)",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--30)",
						"right": "var(--wp--preset--spacing--30)"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium-plus)",
					"fontStyle": "normal",
					"lineHeight": "1.6"
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal",
							"fontWeight": "600"
						},
						"color": {
							"text": "var(--wp--preset--color--paragraph)"
						}
					}
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--paragraph)",
						"style": "solid",
						"width": "1px"
					},
					"right": {
						"width": "0"
					},
					"bottom": {
						"color": "var(--wp--preset--color--paragraph)",
						"style": "solid",
						"width": "1px"
					},
					"left": {
						"width": "0"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.35",
					"fontStyle": "normal"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)"
					},
					"margin": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				},
				"elements": {
					"cite": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)",
							"fontStyle": "normal",
							"textTransform": "none"
						}
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				},
				"border": {
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--paragraph)"
				},
				"elements": {
					"caption": {
						"typography": {
							"fontSize": "var(--wp--preset--font-size--small)"
						},
						"color": {
							"text": "var(--wp--preset--color--paragraph)"
						},
						"spacing": {
							"margin": {
								"top": "0.5rem",
								"bottom": "0"
							}
						}
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.55"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"right": "1.25rem",
						"bottom": "1rem",
						"left": "1.25rem"
					},
					"margin": {
						"top": "0",
						"bottom": "0"
					}
				},
				"border": {
					"radius": "0.375rem",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--paragraph)"
				}
			},
			"core/preformatted": {
				"color": {
					"background": "var(--wp--preset--color--surface)",
