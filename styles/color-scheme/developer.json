{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Developer",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#0d1117",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#e6edf3",
					"name": "Contrast"
				},
				{
					"slug": "paragraph",
					"color": "#8b949e",
					"name": "Paragraph"
				},
				{
					"slug": "primary",
					"color": "#58a6ff",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#3fb950",
					"name": "Secondary"
				},
				{
					"slug": "surface",
					"color": "#161b22",
					"name": "Surface"
				},
				{
					"slug": "transparent",
					"color": "transparent",
					"name": "Transparent"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--paragraph)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--hanken-grotesk)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--base)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			}
		},
		"blocks": {
			"nextora/header": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--jetbrains-mono)"
				}
			}
		}
	}
}
