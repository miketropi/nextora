{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Lime",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#eef2ea",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#071209",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#8EBC5A",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#3d4f36",
					"name": "Secondary"
				},
				{
					"slug": "surface",
					"color": "#dfe8d6",
					"name": "Surface"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--secondary)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
