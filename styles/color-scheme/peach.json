{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Peach",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#fff5f3",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#2d2422",
					"name": "Contrast"
				},
				{
					"slug": "paragraph",
					"color": "#756560",
					"name": "Paragraph"
				},
				{
					"slug": "primary",
					"color": "#fb937f",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#9e7b73",
					"name": "Secondary"
				},
				{
					"slug": "surface",
					"color": "#fde8e4",
					"name": "Surface"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--paragraph)"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"button": {
				"color": {
					"text": "var(--wp--preset--color--contrast)",
					"background": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
