{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/scrolling-promotion",
  "title": "Scrolling Promotion",
  "category": "theme",
  "description": "Continuous horizontal scrolling marquee for text, logos, or text with images.",
  "keywords": ["marquee", "promotion", "announcement", "ticker", "nextora"],
  "textdomain": "nextora",
  "icon": "controls-repeat",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true
    }
  },
  "attributes": {
    "items": {
      "type": "array",
      "default": [
        {
          "itemType": "text",
          "text": "Your promotion here",
          "imageId": 0,
          "imageUrl": "",
          "imageAlt": ""
        }
      ]
    },
    "direction": {
      "type": "string",
      "default": "left"
    },
    "speed": {
      "type": "number",
      "default": 30
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "separatorType": {
      "type": "string",
      "default": "dot"
    },
    "customSeparator": {
      "type": "string",
      "default": "✦"
    },
    "separatorSize": {
      "type": "number",
      "default": 6
    },
    "separatorColor": {
      "type": "string",
      "default": ""
    },
    "fontSize": {
      "type": "number",
      "default": 16
    },
    "fontWeight": {
      "type": "string",
      "default": "500"
    },
    "textTransform": {
      "type": "string",
      "default": "none"
    },
    "letterSpacing": {
      "type": "number",
      "default": 0
    },
    "textColor": {
      "type": "string",
      "default": ""
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "paddingVertical": {
      "type": "number",
      "default": 16
    },
    "itemGap": {
      "type": "number",
      "default": 40
    },
    "imageHeight": {
      "type": "number",
      "default": 32
    },
    "showBorders": {
      "type": "boolean",
      "default": false
    },
    "borderColor": {
      "type": "string",
      "default": ""
    },
    "borderWidth": {
      "type": "number",
      "default": 1
    },
    "ariaLabel": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
