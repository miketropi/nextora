{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/notifications",
  "title": "Notifications",
  "category": "theme",
  "description": "Banner for alerts, announcements, and messages. Supports info, success, warning, and error types with optional dismiss.",
  "keywords": [
    "notification",
    "alert",
    "banner",
    "notice",
    "announcement",
    "nextora"
  ],
  "textdomain": "nextora",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "message": {
      "type": "string",
      "default": ""
    },
    "type": {
      "type": "string",
      "default": "info"
    },
    "showIcon": {
      "type": "boolean",
      "default": true
    },
    "dismissible": {
      "type": "boolean",
      "default": false
    },
    "linkUrl": {
      "type": "string",
      "default": ""
    },
    "linkText": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./style.css"
}
