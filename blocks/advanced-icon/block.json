{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nextora/advanced-icon",
	"title": "Advanced Icon",
	"category": "design",
	"description": "Display a Lucide theme icon or a custom uploaded image icon.",
	"keywords": ["icon", "lucide", "svg", "nextora"],
	"textdomain": "nextora",
	"icon": "star-filled",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": {
			"background": false,
			"text": false,
			"link": false
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"iconSource": {
			"type": "string",
			"default": "theme",
			"enum": ["theme", "upload"]
		},
		"iconName": {
			"type": "string",
			"default": "star"
		},
		"uploadedIconUrl": {
			"type": "string",
			"default": ""
		},
		"uploadedIconId": {
			"type": "number",
			"default": 0
		},
		"iconSize": {
			"type": "number",
			"default": 24
		},
		"iconColor": {
			"type": "string",
			"default": ""
		},
		"strokeWidth": {
			"type": "number",
			"default": 2
		},
		"iconAlign": {
			"type": "string",
			"default": "left"
		},
		"iconStyle": {
			"type": "string",
			"default": "default",
			"enum": ["default", "stacked", "framed"]
		},
		"borderRadius": {
			"type": "number",
			"default": 8
		},
		"surfacePadding": {
			"type": "number",
			"default": 16
		},
		"surfaceBackgroundColor": {
			"type": "string",
			"default": ""
		},
		"surfaceBorderColor": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": "_self"
		},
		"ariaLabel": {
			"type": "string",
			"default": ""
		},
		"enableScrollAnimation": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css"
}
