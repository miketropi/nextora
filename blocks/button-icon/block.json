{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "nextora/button-icon",
	"title": "Button Icon",
	"category": "design",
	"description": "Group of CTA buttons with optional Lucide theme icons or uploaded image icons.",
	"keywords": ["button", "icon", "cta", "lucide", "nextora"],
	"textdomain": "nextora",
	"icon": "button",
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"color": {
			"background": false,
			"text": false,
			"link": false
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"attributes": {
		"buttonAlign": {
			"type": "string",
			"default": "left"
		},
		"enableScrollAnimation": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"style": "file:./style.css",
	"editorStyle": "file:./editor.css"
}
