{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/advanced-button",
  "title": "Advanced Button",
  "category": "nextora",
  "description": "Group of advanced CTA buttons or standalone icons with optional Lucide theme icons or uploaded images.",
  "keywords": [
    "button",
    "icon",
    "cta",
    "lucide",
    "nextora"
  ],
  "textdomain": "nextora",
  "icon": "button",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": false,
      "text": false,
      "link": false
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "fontFamily": true,
      "fontWeight": true
    }
  },
  "attributes": {
    "buttonAlign": {
      "type": "string",
      "default": "left"
    },
    "columnGap": {
      "type": "number",
      "default": 12
    },
    "rowGap": {
      "type": "number",
      "default": 12
    },
    "enableScrollAnimation": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
