{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/blog-list-carousel",
  "title": "Blog List Carousel",
  "category": "design",
  "description": "A dynamic blog post carousel that pulls posts from WordPress and displays them in a Swiper.js card slider.",
  "keywords": [
    "blog",
    "posts",
    "carousel",
    "slider",
    "swiper",
    "nextora"
  ],
  "textdomain": "nextora",
  "icon": "list-view",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "postType": {
      "type": "string",
      "default": "post"
    },
    "postsPerPage": {
      "type": "number",
      "default": 6
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "tags": {
      "type": "array",
      "default": []
    },
    "taxonomyQuery": {
      "type": "string",
      "default": ""
    },
    "taxonomyTerms": {
      "type": "array",
      "default": []
    },
    "excludeIds": {
      "type": "string",
      "default": ""
    },
    "offset": {
      "type": "number",
      "default": 0
    },
    "ignoreSticky": {
      "type": "boolean",
      "default": true
    },
    "headingText": {
      "type": "string",
      "default": ""
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "showViewAll": {
      "type": "boolean",
      "default": true
    },
    "viewAllText": {
      "type": "string",
      "default": "view all"
    },
    "viewAllUrl": {
      "type": "string",
      "default": ""
    },
    "viewAllStyle": {
      "type": "string",
      "default": "pill-outline"
    },
    "viewAllTarget": {
      "type": "boolean",
      "default": false
    },
    "headerLayout": {
      "type": "string",
      "default": "split"
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "imageAspectRatio": {
      "type": "string",
      "default": "16-10"
    },
    "imageSize": {
      "type": "string",
      "default": "medium_large"
    },
    "imageBorderRadius": {
      "type": "number",
      "default": 8
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "titleLineClamp": {
      "type": "number",
      "default": 2
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "excerptLineClamp": {
      "type": "number",
      "default": 3
    },
    "excerptLength": {
      "type": "number",
      "default": 120
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "dateFormat": {
      "type": "string",
      "default": "d M Y"
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": false
    },
    "showReadMore": {
      "type": "boolean",
      "default": false
    },
    "readMoreText": {
      "type": "string",
      "default": "Read More \u2192"
    },
    "cardLinkBehavior": {
      "type": "string",
      "default": "full-card"
    },
    "slidesPerView": {
      "type": "number",
      "default": 3
    },
    "slidesPerViewTablet": {
      "type": "number",
      "default": 2
    },
    "slidesPerViewMobile": {
      "type": "number",
      "default": 1.15
    },
    "spaceBetween": {
      "type": "number",
      "default": 24
    },
    "speed": {
      "type": "number",
      "default": 500
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5000
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": false
    },
    "arrowStyle": {
      "type": "string",
      "default": "minimal"
    },
    "freeMode": {
      "type": "boolean",
      "default": false
    },
    "grabCursor": {
      "type": "boolean",
      "default": true
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "headingColor": {
      "type": "string",
      "default": ""
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "excerptColor": {
      "type": "string",
      "default": ""
    },
    "metaColor": {
      "type": "string",
      "default": ""
    },
    "viewAllColor": {
      "type": "string",
      "default": ""
    },
    "paginationColor": {
      "type": "string",
      "default": ""
    },
    "paginationActiveColor": {
      "type": "string",
      "default": ""
    },
    "paddingTop": {
      "type": "number",
      "default": 80
    },
    "paddingBottom": {
      "type": "number",
      "default": 80
    },
    "contentMaxWidth": {
      "type": "string",
      "default": "1200px"
    },
    "cardBorderRadius": {
      "type": "number",
      "default": 0
    },
    "cardBackground": {
      "type": "string",
      "default": ""
    },
    "cardPadding": {
      "type": "number",
      "default": 0
    },
    "enableScrollAnimation": {
      "type": "boolean",
      "default": true
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
