{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/blog-list-carousel",
  "title": "Blog List Carousel",
  "category": "design",
  "description": "A dynamic blog post carousel that pulls posts from WordPress and displays them in a Swiper.js card slider.",
  "keywords": [
    "blog",
    "posts",
    "carousel",
    "slider",
    "swiper",
    "nextora"
  ],
  "textdomain": "nextora",
  "icon": "list-view",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "cardTemplate": {
      "type": "string",
      "default": "default"
    },
    "layoutMode": {
      "type": "string",
      "default": "carousel"
    },
    "gridColumns": {
      "type": "number",
      "default": 3
    },
    "gridColumnGap": {
      "type": "number",
      "default": 24
    },
    "gridRowGap": {
      "type": "number",
      "default": 24
    },
    "gridMinWidth": {
      "type": "number",
      "default": 981
    },
    "postType": {
      "type": "string",
      "default": "post"
    },
    "postsPerPage": {
      "type": "number",
      "default": 6
    },
    "orderBy": {
      "type": "string",
      "default": "date"
    },
    "order": {
      "type": "string",
      "default": "desc"
    },
    "categories": {
      "type": "array",
      "default": []
    },
    "queryRelated": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "default": []
    },
    "taxonomyQuery": {
      "type": "string",
      "default": ""
    },
    "taxonomyTerms": {
      "type": "array",
      "default": []
    },
    "excludeIds": {
      "type": "string",
      "default": ""
    },
    "offset": {
      "type": "number",
      "default": 0
    },
    "ignoreSticky": {
      "type": "boolean",
      "default": true
    },
    "showImage": {
      "type": "boolean",
      "default": true
    },
    "imageAspectRatio": {
      "type": "string",
      "default": "4-3"
    },
    "imageSize": {
      "type": "string",
      "default": "medium_large"
    },
    "imageBorderRadius": {
      "type": "number",
      "default": 8
    },
    "imageWidthPercent": {
      "type": "number",
      "default": 40
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "titleFontSize": {
      "type": "string",
      "default": ""
    },
    "titleLineClamp": {
      "type": "number",
      "default": 2
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "excerptLineClamp": {
      "type": "number",
      "default": 3
    },
    "excerptLength": {
      "type": "number",
      "default": 120
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "dateFormat": {
      "type": "string",
      "default": "d M Y"
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": false
    },
    "showReadMore": {
      "type": "boolean",
      "default": false
    },
    "readMoreText": {
      "type": "string",
      "default": "Read More \u2192"
    },
    "readMoreColor": {
      "type": "string",
      "default": ""
    },
    "cardLinkBehavior": {
      "type": "string",
      "default": "full-card"
    },
    "slidesPerView": {
      "type": "number",
      "default": 3
    },
    "slidesPerViewTablet": {
      "type": "number",
      "default": 2
    },
    "slidesPerViewMobile": {
      "type": "number",
      "default": 1.15
    },
    "spaceBetween": {
      "type": "number",
      "default": 24
    },
    "speed": {
      "type": "number",
      "default": 500
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "autoplayDelay": {
      "type": "number",
      "default": 5000
    },
    "pauseOnHover": {
      "type": "boolean",
      "default": true
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    },
    "showArrows": {
      "type": "boolean",
      "default": false
    },
    "arrowStyle": {
      "type": "string",
      "default": "minimal"
    },
    "freeMode": {
      "type": "boolean",
      "default": false
    },
    "grabCursor": {
      "type": "boolean",
      "default": true
    },
    "cardTitleColor": {
      "type": "string",
      "default": ""
    },
    "cardExcerptColor": {
      "type": "string",
      "default": ""
    },
    "cardMetaColor": {
      "type": "string",
      "default": ""
    },
    "cardBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "cardBorderColor": {
      "type": "string",
      "default": ""
    },
    "cardBorderRadius": {
      "type": "number",
      "default": 0
    },
    "cardPadding": {
      "type": "number",
      "default": 0
    },
    "readMoreLinkColor": {
      "type": "string",
      "default": ""
    },
    "paginationColor": {
      "type": "string",
      "default": ""
    },
    "paginationActiveColor": {
      "type": "string",
      "default": ""
    },
    "arrowColor": {
      "type": "string",
      "default": ""
    },
    "enableScrollAnimation": {
      "type": "boolean",
      "default": true
    },
    "scrollAnimationStyle": {
      "type": "string",
      "default": "default"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
