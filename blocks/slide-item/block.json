{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/slide-item",
  "title": "Slide item",
  "category": "design",
  "description": "One slide: background, overlay, and inner content blocks.",
  "keywords": ["slide", "hero", "nextora"],
  "textdomain": "nextora",
  "parent": ["nextora/slide-wrapper"],
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true,
      "link": true
    }
  },
  "attributes": {
    "backgroundType": {
      "type": "string",
      "default": "image"
    },
    "backgroundImageId": {
      "type": "number",
      "default": 0
    },
    "backgroundImageAlt": {
      "type": "string",
      "default": ""
    },
    "backgroundVideoId": {
      "type": "number",
      "default": 0
    },
    "backgroundPosition": {
      "type": "string",
      "default": "center center"
    },
    "backgroundSize": {
      "type": "string",
      "default": "cover"
    },
    "backgroundColor": {
      "type": "string",
      "default": ""
    },
    "overlayColor": {
      "type": "string",
      "default": ""
    },
    "overlayOpacity": {
      "type": "number",
      "default": 0.4
    },
    "overlayGradient": {
      "type": "string",
      "default": ""
    },
    "overlayMode": {
      "type": "string",
      "default": "color"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
