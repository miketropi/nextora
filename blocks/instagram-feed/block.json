{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "nextora/instagram-feed",
  "title": "Instagram Feed",
  "category": "design",
  "description": "Curated Instagram-style feed with square tiles, carousel, and lightbox popup.",
  "keywords": ["instagram", "social", "feed", "carousel", "gallery", "nextora"],
  "textdomain": "nextora",
  "icon": "instagram",
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true,
    "color": {
      "background": true,
      "text": true,
      "link": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true
    }
  },
  "attributes": {
    "posts": {
      "type": "array",
      "default": [
        {
          "id": "1",
          "mediaType": "image",
          "mediaId": 0,
          "mediaUrl": "",
          "mediaAlt": "",
          "posterId": 0,
          "posterUrl": "",
          "videoUrl": "",
          "caption": "Introducing our new collection ✨",
          "permalink": "https://instagram.com/"
        },
        {
          "id": "2",
          "mediaType": "image",
          "mediaId": 0,
          "mediaUrl": "",
          "mediaAlt": "",
          "posterId": 0,
          "posterUrl": "",
          "videoUrl": "",
          "caption": "Behind the scenes 🌿",
          "permalink": "https://instagram.com/"
        },
        {
          "id": "3",
          "mediaType": "image",
          "mediaId": 0,
          "mediaUrl": "",
          "mediaAlt": "",
          "posterId": 0,
          "posterUrl": "",
          "videoUrl": "",
          "caption": "",
          "permalink": "https://instagram.com/"
        },
        {
          "id": "4",
          "mediaType": "image",
          "mediaId": 0,
          "mediaUrl": "",
          "mediaAlt": "",
          "posterId": 0,
          "posterUrl": "",
          "videoUrl": "",
          "caption": "",
          "permalink": "https://instagram.com/"
        },
        {
          "id": "5",
          "mediaType": "image",
          "mediaId": 0,
          "mediaUrl": "",
          "mediaAlt": "",
          "posterId": 0,
          "posterUrl": "",
          "videoUrl": "",
          "caption": "",
          "permalink": "https://instagram.com/"
        }
      ]
    },
    "contentMaxWidth": { "type": "string", "default": "1200px" },
    "tileBorderRadius": { "type": "number", "default": 8 },
    "tileBackground": { "type": "string", "default": "" },
    "showTileOverlay": { "type": "boolean", "default": false },
    "tileImageSize": { "type": "string", "default": "large" },
    "slidesPerView": { "type": "number", "default": 5 },
    "slidesPerViewTablet": { "type": "number", "default": 3 },
    "slidesPerViewMobile": { "type": "number", "default": 2.15 },
    "spaceBetween": { "type": "number", "default": 16 },
    "speed": { "type": "number", "default": 500 },
    "loop": { "type": "boolean", "default": false },
    "freeMode": { "type": "boolean", "default": false },
    "grabCursor": { "type": "boolean", "default": true },
    "autoplay": { "type": "boolean", "default": false },
    "autoplayDelay": { "type": "number", "default": 5000 },
    "pauseOnHover": { "type": "boolean", "default": true },
    "showPagination": { "type": "boolean", "default": false },
    "paginationType": { "type": "string", "default": "bullets" },
    "showArrows": { "type": "boolean", "default": false },
    "arrowStyle": { "type": "string", "default": "minimal" },
    "enableLightbox": { "type": "boolean", "default": true },
    "lightboxShowArrows": { "type": "boolean", "default": true },
    "lightboxShowCaption": { "type": "boolean", "default": true },
    "lightboxLinkText": { "type": "string", "default": "View on Instagram" },
    "lightboxHandleOverride": { "type": "string", "default": "" },
    "backgroundColor": { "type": "string", "default": "" },
    "tileOverlayColor": { "type": "string", "default": "" },
    "paginationColor": { "type": "string", "default": "" },
    "paginationActiveColor": { "type": "string", "default": "" },
    "lightboxSidebarBackground": { "type": "string", "default": "" },
    "enableScrollAnimation": { "type": "boolean", "default": true }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./view.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
