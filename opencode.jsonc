{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".cursor/rules/*.mdc"
  ],
  "lsp": {
    "php intelephense": {
      "initialization": {
        "files": {
          "maxSize": 4000000
        }
      }
    },
    "typescript": {}
  },
  "permission": {
    "skill": {
      "gsap-*": "allow",
      "nextora-*": "allow"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
