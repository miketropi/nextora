{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".cursor/rules/*.mdc"
  ],
  "permission": {
    "skill": {
      "gsap-*": "allow",
      "nextora-*": "allow"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "task": {
          "planner": "allow",
          "builder": "allow",
          "reviewer": "allow",
          "qa": "allow"
        }
      }
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    }
  }
}
