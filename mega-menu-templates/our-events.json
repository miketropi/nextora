{"version": "1.0.0","slug": "our-events","title": "Our Events","description": "Upcoming events, workshops, and community gatherings.","settings": {"width": "container","bgColor": "","animation": "none"},"content": "<!-- wp:group {\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|30\",\"right\":\"var:preset|spacing|30\"},\"margin\":{\"top\":\"0\",\"bottom\":\"0\"}}},\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\" style=\"margin-top:0;margin-bottom:0;padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--30);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--30)\"><!-- wp:columns {\"align\":\"wide\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"0\",\"bottom\":\"0\"},\"blockGap\":{\"top\":\"var:preset|spacing|30\",\"left\":\"var:preset|spacing|50\"}}}} -->\n<div class=\"wp-block-columns alignwide\" style=\"margin-top:0;margin-bottom:0\"><!-- wp:column {\"width\":\"63%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:63%\"><!-- wp:heading {\"level\":4,\"className\":\"animation-fade-in-up\",\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"0.5em\"}}}} -->\n<h4 class=\"wp-block-heading animation-fade-in-up\" style=\"margin-bottom:0.5em\">Our Events</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph {\"textColor\":\"paragraph\",\"className\":\"animation-fade-in-up\",\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|paragraph\"}}},\"spacing\":{\"padding\":{\"top\":\"0\",\"bottom\":\"0\"}}}} -->\n<p class=\"animation-fade-in-up has-paragraph-color has-text-color has-link-color\" style=\"padding-top:0;padding-bottom:0\">Explore our calendar of upcoming events and activities.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:nextora/box-image {\"items\":[{\"id\":\"1\",\"title\":\"Fundraiser\",\"description\":\"Join us for a meaningful cause.\",\"showLink\":true,\"linkLabel\":\"learn more\",\"linkUrl\":\"#\",\"linkTarget\":\"_self\",\"imageId\":3314,\"imageUrl\":\"http://alonepro.local/wp-content/uploads/2026/07/Screenshot-at-Jul-14-14-18-46.png\",\"backgroundColor\":\"\",\"titleColor\":\"\",\"descriptionColor\":\"\",\"linkColor\":\"\",\"badge\":\"New\",\"linkWrapCard\":true},{\"id\":\"2\",\"title\":\"Volunteer Day\",\"description\":\"Make a difference in your community.\",\"showLink\":true,\"linkLabel\":\"sign up\",\"linkUrl\":\"#\",\"linkTarget\":\"_self\",\"imageId\":2736,\"imageUrl\":\"http://alonepro.local/wp-content/uploads/2026/07/pexels-max-fischer-5212363.jpg\",\"backgroundColor\":\"\",\"titleColor\":\"\",\"descriptionColor\":\"\",\"linkColor\":\"\",\"badge\":\"\",\"linkWrapCard\":true},{\"id\":\"3\",\"title\":\"Youth Summit\",\"description\":\"Empowering the next generation of leaders.\",\"showLink\":true,\"linkLabel\":\"\",\"linkUrl\":\"#\",\"linkTarget\":\"_self\",\"imageId\":3104,\"imageUrl\":\"http://alonepro.local/wp-content/uploads/2026/07/pexels-rdne-6129048.jpg\",\"backgroundColor\":\"\",\"titleColor\":\"\",\"descriptionColor\":\"\",\"linkColor\":\"\",\"badge\":\"\",\"linkWrapCard\":true}],\"layoutMode\":\"grid\",\"gridColumns\":3,\"gridMinWidth\":793,\"disableResponsiveCarousel\":true,\"imageAspectRatio\":\"16/11\",\"cardMinHeight\":0,\"cardBorderRadius\":10,\"spaceBetween\":20,\"scrollAnimationStyle\":\"sequential\",\"enableCardHover\":false,\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|20\"}}}} /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"37.3%\"} -->\n<div class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:37.3%\"><!-- wp:nextora/testimonials {\"template\":\"template-02\",\"testimonials\":[{\"id\":\"1\",\"quoteText\":\"Growing up without a family was difficult, but finding a safe and caring home changed my life. I received love, education, and the confidence to believe in a brighter future filled with hope and opportunity.\",\"authorName\":\"Zainab\",\"authorAge\":\"16 Years\",\"authorLocation\":\"Lagos, Nigeria\",\"portraitId\":3134,\"portraitUrl\":\"\",\"portraitAlt\":\"\"},{\"id\":\"2\",\"quoteText\":\"The scholarship program gave me the opportunity to continue my education when my family could no longer afford it. Today, I'm studying engineering and moving closer to achieving my lifelong dreams, one step at a time.\",\"authorName\":\"Amara\",\"authorAge\":\"14 Years\",\"authorLocation\":\"Nairobi, Kenya\",\"portraitId\":3076,\"portraitUrl\":\"\",\"portraitAlt\":\"\"},{\"id\":\"3\",\"quoteText\":\"When I became seriously ill, treatment was beyond my family's means. Thanks to the medical support I received, I recovered, returned to school, and now look forward to a brighter future with renewed hope.\",\"authorName\":\"Fatou\",\"authorAge\":\"15 Years\",\"authorLocation\":\"Dakar, Senegal\",\"portraitId\":2736,\"portraitUrl\":\"\",\"portraitAlt\":\"\"}],\"quoteFontSize\":\"base\",\"autoplay\":false,\"enableScrollAnimation\":false,\"className\":\"animation-fade-in-up\",\"style\":{\"spacing\":{\"margin\":{\"top\":\"var:preset|spacing|10\",\"bottom\":\"0\",\"left\":\"0\",\"right\":\"0\"}}}} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns --></div>\n<!-- /wp:group -->"}