{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "external_directory": {
      "/Users/ducdung/Local Sites/alonepro/app/public/wp-content/themes/alonepro/**": "allow"
    }
  },
  "plugin": [
    [
      "file:///Volumes/Mike/tools/opencode-qdrant-plugin",
      {
        "qdrantUrl": "http://localhost:6333",
        "embeddingProvider": "local",
        "indexOnStart": true,
        "excludePatterns": [
          ".roo/**"
        ]
      }
    ]
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect"
      ],
      "enabled": true
    }
  }
}